# ── WhatsApp Business Platform (Meta Cloud API) ────────────────────────────
# Blank = feature off: sends short-circuit, webhook returns 503. Server-only.
#
# Sender: +27 63 441 4112 ("GhostAi"), registered 2026-07-20, status CONNECTED.
# NOTE: this number lives on WABA 858002623803590, NOT the WABA the app's dev
# console defaults to (2044791883587895 = "Test WhatsApp Business Account").
# That is why it never appears in the Step 1 "From" dropdown.
WHATSAPP_PHONE_NUMBER_ID=1223209977543882
WHATSAPP_BUSINESS_ACCOUNT_ID=858002623803590
# Needs a PERMANENT system-user token — the dev-console token expires in 24h.
# business.facebook.com -> Business settings -> Users -> System users -> Add,
# Admin, Generate token for app ai_agent (1819447232013800) with
# whatsapp_business_messaging + whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# App Dashboard -> Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any string we choose; paste the same value into the webhook setup form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional — defaults to v21.0
WHATSAPP_GRAPH_VERSION=
